PORT=5000
NODE_ENV=development
ENABLE_DEV_SEED=false
SESSION_TTL_MS=28800000
FRONTEND_URL=http://localhost:5173
DB_PATH=./helpdesk-dev.sqlite
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASS=substitua_por_uma_senha_segura
SMTP_FROM=Goldtech Helpdesk <noreply@example.com>
GOLDTECH_ARCHIVE_EMAIL=arquivo@example.com
VISIT_DOCUMENTS_PATH=./storage/visits
# Microsoft Graph: application Mail.Send permission with admin consent.
# SMTP above remains in use only by the legacy password-reset email.
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-application-id
MS_CLIENT_SECRET=replace-with-client-secret
MS_SENDER_EMAIL=visitas@example.com
